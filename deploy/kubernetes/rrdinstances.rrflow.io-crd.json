{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "rrdinstances.rrflow.io"
  },
  "spec": {
    "group": "rrflow.io",
    "names": {
      "kind": "RrdInstance",
      "plural": "rrdinstances",
      "shortNames": [
        "rrd"
      ],
      "singular": "rrdinstance"
    },
    "scope": "Namespaced",
    "versions": [
      {
