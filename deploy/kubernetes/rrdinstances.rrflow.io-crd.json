                    "minimum": 0.0,
                    "type": "integer"
                  },
                  "bootstrapCredentialSecret": {
                    "maxLength": 63,
                    "minLength": 1,
                    "type": "string"
                  },
                  "bootstrapManifestConfigMap": {
                    "maxLength": 63,
                    "minLength": 1,
                    "type": "string"
                  },
                  "contractVersion": {
                    "format": "uint16",
                    "maximum": 65535.0,
                    "minimum": 0.0,
                    "type": "integer"
                  },
                  "image": {
                    "description": "Immutable image reference. Tags are rejected; a sha256 digest is required.",
                    "type": "string"
                  },
                  "instanceId": {
                    "description": "A canonical public identifier component.\n\nIDs are lowercase ASCII and intentionally URL/path safe. Human-facing\nlabels are separate data and may use arbitrary Unicode.",
                    "type": "string"
                  },
                  "storage": {
                    "properties": {
                      "retainOnDelete": {
                        "default": true,
                        "type": "boolean"
                      },
                      "size": {
