                    ],
                    "type": "object"
                  },
                  "tlsSecret": {
                    "maxLength": 63,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "bootstrapAtUnixMs",
                  "bootstrapCredentialSecret",
                  "bootstrapManifestConfigMap",
                  "contractVersion",
                  "image",
                  "instanceId",
                  "storage",
                  "tlsSecret"
                ],
                "type": "object",
                "x-kubernetes-validations": [
                  {
                    "message": "contractVersion must be 1",
                    "rule": "self.contractVersion == 1"
                  },
                  {
                    "message": "bootstrapAtUnixMs must be positive",
                    "rule": "self.bootstrapAtUnixMs > 0"
                  },
                  {
                    "message": "PVC retention is mandatory in v1alpha1",
                    "rule": "self.storage.retainOnDelete == true"
                  },
                  {
                    "message": "image must be pinned by canonical sha256 digest",
                    "rule": "self.image.matches('^.+@sha256:[0-9a-f]{64}$')"
                  },
                  {
                    "message": "storage size must be a positive binary quantity",
                    "rule": "self.storage.size.matches('^[1-9][0-9]*(Ki|Mi|Gi|Ti)$')"
                  },
                  {
                    "message": "tlsSecret must be one DNS label",
                    "rule": "self.tlsSecret.matches('^[a-z0-9]([-a-z0-9]*[a-z0-9])?$')"
                  },
                  {
                    "message": "bootstrapManifestConfigMap must be one DNS label",
                    "rule": "self.bootstrapManifestConfigMap.matches('^[a-z0-9]([-a-z0-9]*[a-z0-9])?$')"
                  },
                  {
                    "message": "bootstrapCredentialSecret must be one DNS label",
                    "rule": "self.bootstrapCredentialSecret.matches('^[a-z0-9]([-a-z0-9]*[a-z0-9])?$')"
                  }
                ]
              },
              "status": {
